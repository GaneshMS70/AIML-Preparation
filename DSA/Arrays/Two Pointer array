def find_target(nums,target):
    left=0
    right=len(nums)-1
    while left<right:
        current_sum=nums[left]+nums[right]
        print(current_sum)
        if current_sum==target:
            return [left,right]
        elif current_sum<target:
            left+=1
        else:
            right-=1
    return None

nums=[10,20,30,40,50,60,100,70,80,90,]
target=150
result=find_target(nums,target)
print(result)
